<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#38FFFFFF" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#24FFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
