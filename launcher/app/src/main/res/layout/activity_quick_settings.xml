<?xml version="1.0" encoding="utf-8"?>
<!-- Quick settings opened by the remote's Settings button: the Inputs dropdown's glass panel, placed
     under the Settings pill so it lines up on Home and sits top right over any app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:descendantFocusability="afterDescendants">

    <RelativeLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:minWidth="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="105dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/glass_panel"
        android:padding="6dp"
        android:elevation="12dp"
        android:clipChildren="false">

        <com.gathin.tvhome.QuickSettingsFocusIndicator
            android:id="@+id/focusIndicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignStart="@id/rows"
            android:layout_alignEnd="@id/rows"
            android:layout_alignTop="@id/rows"
            android:layout_alignBottom="@id/rows"
            android:clipChildren="false"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="wrap_content"
            android:minWidth="208dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="false"
            android:descendantFocusability="afterDescendants" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/launchCurtain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:elevation="24dp"
        android:alpha="0"
        android:visibility="invisible"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/launchCurtainArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:alpha="0"
            android:visibility="invisible"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
