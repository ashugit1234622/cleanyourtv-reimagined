<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="64dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_bridge_title"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/bridgeStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FF6EC1FF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/bridgeToggleButton"
            style="@style/SettingsRow"
            android:layout_marginTop="20dp"
            android:focusable="true"
            android:text="@string/phone_bridge_toggle_on" />

        <LinearLayout
            android:id="@+id/pairingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bridgeAddressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/bridgeQrImage"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:background="#FFFFFFFF"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Pairing QR Code" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Or enter this PIN on your phone:"
                        android:textColor="#FFACB8C1"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/bridgePinText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FF1E2630"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:fontFamily="monospace"
                        android:textColor="#FFFFD15C"
                        android:textSize="36sp" />

                    <TextView
                        android:id="@+id/bridgeExpiryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#FFACB8C1"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/bridgeHelpText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#FF7E8C9A"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/bridgeUnpairButton"
                style="@style/SettingsRow"
                android:layout_marginTop="28dp"
                android:focusable="true"
                android:text="@string/phone_bridge_unpair_all" />

            <TextView
                android:id="@+id/bridgeClearRememberedButton"
                style="@style/SettingsRow"
                android:layout_marginTop="12dp"
                android:focusable="true"
                android:text="@string/phone_bridge_clear_remembered" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
