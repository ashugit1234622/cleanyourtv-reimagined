<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="14dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/recentCard"
        android:layout_width="240dp"
        android:layout_height="135dp"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/recentCardArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/recentBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/recentIcon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <View
            android:id="@+id/recentFocusRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/recents_card_focus_ring"
            android:visibility="invisible" />
    </FrameLayout>

    <TextView
        android:id="@+id/recentName"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:fontFamily="@string/font_medium"
        android:letterSpacing="0.01" />

    <TextView
        android:id="@+id/recentRamBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="4dp"
        android:background="@drawable/recents_ram_pill_bg"
        android:textColor="#FFE0EEFF"
        android:textSize="13sp"
        android:fontFamily="@string/font_medium"
        android:includeFontPadding="false" />
</LinearLayout>

